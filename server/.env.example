# Copy to .env in the same folder as docker-compose.yml.
#
# Generate random values for the two secret keys below — don't reuse
# these placeholders. On macOS/Linux you can generate one with:
#   openssl rand -hex 32

WEBUI_SECRET_KEY=change-me-to-a-random-value
SEARXNG_SECRET_KEY=change-me-to-a-different-random-value
