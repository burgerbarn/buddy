# Copy this file to .env and fill in your own values.
# .env is gitignored — it's where your real, personal config lives.

# Prefilled server URL shown in Settings on first launch (EXPO_PUBLIC_ vars
# get bundled into the JS, so this is not a secret, just a convenience default —
# the real value the app uses is still whatever you type into Settings, stored
# in SecureStore).
EXPO_PUBLIC_DEFAULT_SERVER_URL=https://your-server.example.com

# Used by app.config.js at build time (not bundled into the JS app).
APPLE_TEAM_ID=YOUR_TEAM_ID
IOS_BUNDLE_ID=com.example.buddy
ANDROID_PACKAGE=com.example.buddy
